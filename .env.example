# openmarket-corpo — environment template
#
# Usage:
#   Docker Compose: cp .env.example .env  → compose auto-reads it for ${...} substitution
#   Local dev:      source it manually (make auth does NOT source this file):
#                     set -a; source .env.local; set +a   (or export vars in your shell)
#
# NEVER put real secrets in a committed file. This file documents names + dev defaults.

# ─────────────────────────────────────────────────────────────────────────────
# Core (read by docker compose for ${...} substitution in docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres superuser password. Compose bakes it into every service's DATABASE_URL.
# Default below is the dev-only fallback compiled into the services — change it for
# anything shared or prod-like.
POSTGRES_PASSWORD=devpassword123

# ─────────────────────────────────────────────────────────────────────────────
# Local dev fallbacks (auth reads these directly; compose does NOT use them —
# it always builds DATABASE_URL instead)
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=om

# ─────────────────────────────────────────────────────────────────────────────
# Shared infrastructure (injected by compose; set manually for bare-metal runs)
# ─────────────────────────────────────────────────────────────────────────────

# libpq-style URL. Every service reads this first; auth additionally falls back
# to the discrete POSTGRES_* vars above. Local dev against `make infra-up`:
#   postgres://om:devpassword123@localhost:5432/<db>
# Databases per service: auth_db, catalogue_db, messaging_db, notif_db, asset_db, admin_db
#DATABASE_URL=

# Kafka bootstrap servers (catalogue, messaging, presence, admin; auth has an
# outbox table but no Kafka client yet, so the var is unused there today)
KAFKA_BROKERS=localhost:9092

# Redis (gateway, messaging, presence). Currently passed but not yet consumed by
# any service; note compose uses two formats (gateway/messaging: host:port,
# presence: redis://host:port) — pick per-service when wiring it up.
REDIS_URL=localhost:6379

# OpenTelemetry OTLP/HTTP collector (Jaeger all-in-one in dev)
OTLP_ENDPOINT=http://localhost:4318

# ─────────────────────────────────────────────────────────────────────────────
# Auth service (services/auth)
# ─────────────────────────────────────────────────────────────────────────────

# RSA JWK file for signing access tokens. If missing, auth AUTO-GENERATES a new
# key (invalidates all sessions + rotates JWKS) — mount a real key in prod.
# Compose keeps it on a named volume; locally the default relative path is fine.
#JWT_KEY_PATH=keys/jwt-rsa.jwk

# Secure cookies. Keep true everywhere except exotic non-localhost plain-HTTP dev.
AUTH_COOKIE_SECURE=false

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For we trust.
# Empty = trust nobody (default, correct unless auth sits behind a known proxy).
#AUTH_TRUSTED_PROXY_IP=

# Frontend base URL used in emailed verification/reset links
APP_URL=http://localhost:3000

# Mail (dev default is Mailpit via compose; empty host = mail sending is a no-op)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=OpenMarket <no-reply@openmarket.dev>

# ── Discord OAuth (required for /api/v1/auth/discord to work) ────────────────
# Create an app at https://discord.com/developers/applications → OAuth2.
# Redirect URI must match the app config; default goes through the gateway.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
#DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback
#DISCORD_SCOPES=identify email
#OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/success
#OAUTH_FAILURE_REDIRECT=http://localhost:3000/auth/failure
#DISCORD_CONNECT_TIMEOUT_MS=3000
#DISCORD_READ_TIMEOUT_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# Gateway (services/gateway) — upstream URLs, compose injects these; override
# only if you rearrange the topology
# ─────────────────────────────────────────────────────────────────────────────

#PORT=3000
#AUTH_URL=http://auth:8080
#CATALOGUE_URL=http://catalogue:8081
#MESSAGING_URL=http://messaging:8082
#PRESENCE_URL=http://presence:8083
#ASSETS_URL=http://assets:8084
#ADMIN_URL=http://admin:8085
